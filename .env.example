# Configurações do Supabase para PlayContas
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Configurações da SyncPay / Syndpay (Split de Pagamentos)
# Obtenha em https://app.syncpayments.com.br / Configurações de API
# Documentação: https://docs.syncpayments.com.br/
SYNCPAY_CLIENT_ID=seu_client_id_aqui
SYNCPAY_CLIENT_SECRET=seu_client_secret_aqui
SYNCPAY_BASE_URL=https://api.syncpayments.com.br/api/partner/v1
SYNCPAY_WEBHOOK_URL=https://seusite.com/api/webhooks/syncpay
SYNCPAY_PLATFORM_FEE_PERCENTAGE=13
